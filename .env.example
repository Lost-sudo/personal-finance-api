NODE_ENV=development
APP_ENV=development
PORT=3000

DATABASE_URL="postgresql://finance_app:YOUR_PASSWORD@localhost:5432/personal_finance?schema=public"

# Minimum 32 characters each, must differ from each other.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit real secrets; keep them in your local .env only.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API with credentials.
# Empty disables CORS (safe default for non-production). Production requires
# explicit origins, e.g. CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Optional rate-limit overrides (defaults shown).
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60000

# Serve Swagger at /api/docs. Defaults: on outside production, off in production.
SWAGGER_ENABLED=

RECURRING_GENERATION_JOB=recurring-transaction-generation

# How often due recurring schedules are materialized (five-field cron, UTC).
RECURRING_GENERATION_CRON=*/1 * * * *
# Max occurrences materialized for one schedule per sweep; the remainder is
# picked up by later sweeps.
RECURRING_GENERATION_CATCH_UP_LIMIT=31

NODE_ENV=development
APP_ENV=development
PORT=3000

DATABASE_URL="postgresql://finance_app:YOUR_PASSWORD@localhost:5432/personal_finance?schema=public"

JWT_ACCESS_SECRET=example-jwt-secret
JWT_EXPIRES_IN=15m

RECURRING_GENERATION_JOB=recurring-transaction-generation

# How often due recurring schedules are materialized (five-field cron, UTC).
RECURRING_GENERATION_CRON=*/1 * * * *
# Max occurrences materialized for one schedule per sweep; the remainder is
# picked up by later sweeps.
RECURRING_GENERATION_CATCH_UP_LIMIT=31